# Shared secret required to trigger GET /api/ping in production.
# Vercel Cron automatically sends it as `Authorization: Bearer $CRON_SECRET`;
# external crons can use either the header or `?key=<CRON_SECRET>`.
# Generate one with: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
CRON_SECRET=replace-me-with-a-long-random-string

# Optional: override services.json WITHOUT redeploying (single-line JSON array).
# Takes full precedence over services.json.
# SERVICES=[{"name":"my-api","url":"https://my-api.onrender.com/actuator/health","strict":true}]
